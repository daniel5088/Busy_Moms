# Supabase Configuration
# Get these values from: https://app.supabase.com → Your Project → Settings → API

# Your Supabase project URL (e.g., https://xxxxx.supabase.co)
VITE_SUPABASE_URL=https://xxxxx.supabase.co

# Your Supabase anonymous/public key (starts with eyJ...)
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# NOTE: Google Maps API Key is stored in Supabase Secrets (not in .env)
# It's accessed server-side through edge functions for security
